# Backend API URL (Rust Backend)
# 前端直接调用 Rust 后端 API，不使用 Next.js API Route
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# WebSocket URL (可选)
# 如果 API 和 WebSocket 服务在同一域名下，可以省略此项（会从 NEXT_PUBLIC_API_URL 自动推导）
# 如果 API 和 WebSocket 服务在不同域名下，需要显式设置此项
# NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Site URL (用于 SEO、sitemap、robots.txt 等)
NEXT_PUBLIC_SITE_URL=https://www.tnxg.moe

# Cloudflare Turnstile Site Key (公开密钥，用于前端人机验证)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key

# Revalidation Configuration (服务器端专用)
# 用于验证来自 Rust 后端的 ISR 缓存重新验证请求
REVALIDATION_SECRET=your-super-secret-revalidation-key-change-this
REVALIDATION_SALT=your-random-salt-value

# 注意: REVALIDATION_SECRET 必须与后端 Rust 配置中的值完全一致

# OAuth Configuration (Optional - for reference)
# OAuth 流程由 Rust 后端处理，前端只需要知道后端 URL
# GitHub OAuth: {NEXT_PUBLIC_API_URL}/api/auth/oauth/github
# QQ OAuth: {NEXT_PUBLIC_API_URL}/api/auth/oauth/qq
