{
  "name": "neo-space",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "turbo run dev --filter=@neo-space/web",
    "dev:backend": "turbo run dev --filter=@neo-space/backend",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@neo-space/web",
    "build:backend": "turbo run build --filter=@neo-space/backend",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "fmt": "pnpm --filter=@neo-space/web run fmt",
    "fmt:fix": "pnpm --filter=@neo-space/web run fmt:fix",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "next": "16.3.0",
    "turbo": "2.9.6"
  },
  "engines": {
    "node": ">=22"
  }
}
