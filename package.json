{
  "name": "neo-space",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.3+sha512.c85357fe17ca12dd23dd7071822666dfd7e3cb76fe214e3370b5ea2fb34f2a231185509b63e717f3cd0acb38dd3f8d82bcd5e8172400ae678b70ea4fbed0896d",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "turbo run dev --filter=@neo-space/web",
    "dev:admin": "turbo run dev --filter=@neo-space/admin",
    "dev:backend": "turbo run dev --filter=@neo-space/backend",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@neo-space/web",
    "build:admin": "turbo run build --filter=@neo-space/admin",
    "build:backend": "turbo run build --filter=@neo-space/backend",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "fmt": "pnpm -r --parallel --filter=@neo-space/web --filter=@neo-space/admin run fmt",
    "fmt:fix": "pnpm -r --parallel --filter=@neo-space/web --filter=@neo-space/admin run fmt:fix",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "2.9.6"
  },
  "engines": {
    "node": ">=22"
  }
}
