# 后端 / Docker Compose 环境变量
# 复制为仓库根目录 .env。后端从 apps/backend 启动时 dotenv 会向上找到它；
# docker-compose.yml 也读取同一个文件。
#
# 本地开发若连接共享 / 线上数据库，务必保留 ENV_OPTIONS_SYNC=false，
# 否则启动时会把这里的 URL、OAuth、Turnstile 等值写回数据库 options 集合。

# ==================== 数据库 ====================
MONGODB_URI=mongodb://localhost:27017/mx-space
# 连接超时（秒）与连接池大小
# MONGODB_TIMEOUT_SECS=30
# MONGODB_MAX_POOL_SIZE=10

# Docker Compose 启动 MongoDB 时使用
# MONGO_ROOT_USERNAME=admin
# MONGO_ROOT_PASSWORD=change-this
# MONGO_DATABASE=mx-space

# ==================== 基础 ====================
# 可选值: error, warn, info, debug, trace
RUST_LOG=info

# JWT 签名密钥（必需，至少 32 字符）
JWT_SECRET=local-dev-jwt-secret-at-least-32-characters

# Owner 桌面客户端令牌（必需）
OWNER_DESKTOP_TOKEN=local-dev-owner-desktop-token

# 后端固定监听 0.0.0.0:8000；如需修改端口请同时调整 web 的 API 地址
PORT=8000

# ==================== URL ====================
# 前台 URL（OAuth 回调、CORS 白名单、ISR 目标来源）
FRONTEND_URL=http://localhost:3000
# 后端 URL（OAuth redirect_uri）
BACKEND_URL=http://localhost:8000
# Next.js 服务地址（ISR 重新验证请求的目标）
NEXTJS_URL=http://localhost:3000

# ==================== 配置写回数据库 ====================
# true（默认）：启动时把下面的环境变量写回 options 集合，方便首次部署初始化。
# false：只做运行时覆盖，不修改数据库；本地连共享库时必须用 false。
ENV_OPTIONS_SYNC=false

# ==================== OAuth / 人机验证 ====================
# 首次迁移源，之后以数据库 options 为准
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret
# QQ_APP_ID=your-qq-app-id
# QQ_APP_KEY=your-qq-app-key
# TURNSTILE_SECRET=0x44444444444444

# ==================== ISR 重新验证 ====================
# 必须与 apps/web/.env.local 中的 REVALIDATION_SECRET / REVALIDATION_SALT 一致；
# 不配置 REVALIDATION_SECRET 时后端不会向 Next.js 发送刷新请求。
REVALIDATION_SECRET=your-super-secret-revalidation-key-change-this
REVALIDATION_SALT=your-random-salt-value

# ==================== 友链健康检查 ====================
LINK_HEALTH_TIMEOUT=10
LINK_HEALTH_CHECK_INTERVAL_HOURS=6

# ==================== 评论默认值（首次迁移源） ====================
# COMMENTS_DISABLED=false
# COMMENTS_ALLOW_NO_CHINESE=true
# COMMENTS_REQUIRE_AUDIT=true
# COMMENTS_RECORD_IP_LOCATION=true
# COMMENTS_BLOCKED_IPS=
# COMMENTS_SPAM_KEYWORDS=
# FRIEND_LINK_ALLOW_APPLY=false
# FRIEND_LINK_ALLOW_SUB_PATH=false

# ==================== Meilisearch ====================
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=your-meilisearch-master-key
# Docker Compose 用同一个密钥启动 Meilisearch
MEILISEARCH_MASTER_KEY=your-meilisearch-master-key
MEILISEARCH_VERSION=v1.37

# ==================== 文件上传（可选） ====================
# 上传落盘目录（默认 ./storage/uploads）
# UPLOAD_DIR=./storage/uploads

# ==================== Bangumi 模型缓存（可选） ====================
# BANGUMI_MODEL_CACHE_DIR=./.cache/bangumi
