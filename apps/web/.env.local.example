# apps/web 本地开发环境变量
# 复制为 apps/web/.env.local（Next.js 只读取应用目录下的 .env 文件，不读取仓库根目录）。
#
# 默认对接本机 Rust 后端（http://localhost:8000）。
# 如果后端部署在别处（例如 https://api-blog.tnxg.top），只改 NEXT_PUBLIC_API_URL 与 REVALIDATION_* 即可。

# Backend API URL (Rust Backend)
# 前端直接调用 Rust 后端 API，不使用 Next.js API Route
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# WebSocket URL (可选)
# 未设置时从 NEXT_PUBLIC_API_URL 推导（http://localhost:8000/api -> ws://localhost:8000/ws）
# NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Site URL (用于 SEO、sitemap、robots.txt、OG 链接等)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile Site Key (公开密钥，用于前端人机验证)
# 本地不填则不渲染验证组件；此时后端若已配置 Turnstile Secret，评论提交会被拒绝。
# 需要本地调试评论时，在后台把 Turnstile 换成 Cloudflare 测试密钥：
#   site key: 1x00000000000000000000AA
#   secret:   1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Revalidation Configuration (服务器端专用)
# 用于验证来自 Rust 后端的 ISR 缓存重新验证请求，必须与后端 .env 完全一致
REVALIDATION_SECRET=your-super-secret-revalidation-key-change-this
REVALIDATION_SALT=your-random-salt-value

# TMDB 影视卡片（服务器端专用，推荐使用 API Read Access Token）
# 未配置时会自动降级读取 themoviedb.org 页面的 Open Graph 数据
TMDB_ACCESS_TOKEN=your-tmdb-api-read-access-token
# TMDB_API_KEY=your-tmdb-v3-api-key
# 可选：仅用于纯客户端 Markdown 的 TMDB 官方 API 降级渲染
# NEXT_PUBLIC_TMDB_API_KEY=your-public-tmdb-v3-api-key

# OAuth 流程由 Rust 后端处理，前端只需要知道后端 URL
# GitHub OAuth: {NEXT_PUBLIC_API_URL}/auth/oauth/github
# QQ OAuth: {NEXT_PUBLIC_API_URL}/auth/oauth/qq
