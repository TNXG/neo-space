{
  "name": "@neo-space/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cargo watch --ignore cache --ignore target --ignore '**/*.md' --ignore '**/*.sh' -x run",
    "build": "env -u RUSTC_WRAPPER cargo build --release",
    "build:debug": "env -u RUSTC_WRAPPER cargo build",
    "start": "env -u RUSTC_WRAPPER cargo run --release",
    "lint": "env -u RUSTC_WRAPPER cargo clippy --all-targets --all-features -- -D warnings",
    "lint:fix": "env -u RUSTC_WRAPPER cargo clippy --all-targets --all-features --fix --allow-dirty --allow-staged",
    "typecheck": "env -u RUSTC_WRAPPER cargo check --all-targets --all-features",
    "clean": "cargo clean"
  },
  "dependencies": {
    "@neo-space/admin": "workspace:*"
  }
}
