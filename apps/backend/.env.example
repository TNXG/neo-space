# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/mx-space

# 日志级别配置
# 可选值: error, warn, info, debug, trace
RUST_LOG=info

# JWT Configuration (必需)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Owner Desktop Client Token (必需)
# 用于博主桌面客户端连接 WebSocket 上传窗口和媒体信息的认证令牌
OWNER_DESKTOP_TOKEN=your-super-secret-owner-desktop-token-change-this

# GitHub OAuth Configuration (可选 - 优先从数据库读取)
# 如果数据库中没有配置，则使用这里的环境变量作为后备
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# QQ OAuth Configuration (可选 - 优先从数据库读取)
# 如果数据库中没有配置，则使用这里的环境变量作为后备
QQ_APP_ID=your-qq-app-id
QQ_APP_KEY=your-qq-app-key

# Frontend URL (for OAuth callback redirect)
FRONTEND_URL=http://localhost:3000

# Backend URL (for OAuth redirect_uri)
BACKEND_URL=http://localhost:8000

# Cloudflare Turnstile Secret Key (人机验证)
TURNSTILE_SECRET=0x44444444444444

# Server Configuration
ROCKET_PORT=8000
ROCKET_ADDRESS=0.0.0.0

# Cache Configuration
CACHE_MAX_CAPACITY=10000
CACHE_TTL_SECONDS=3600

# Link Health Check Configuration
# 友链健康检查缓存过期时间（小时），默认 6
LINK_HEALTH_STALE_HOURS=6
# 友链健康检查超时时间（秒），默认 10
LINK_HEALTH_TIMEOUT=10
# 友链定期健康检查间隔（小时），默认 6
LINK_HEALTH_CHECK_INTERVAL=6

# Next.js Revalidation Configuration
NEXTJS_URL=http://localhost:3000
REVALIDATION_SECRET=your-super-secret-revalidation-key-change-this
REVALIDATION_SALT=your-random-salt-value

# Meilisearch Configuration
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=your-meilisearch-master-key

# 配置优先级说明：
# 1. 数据库 options 集合中的配置（最高优先级）
# 2. 环境变量配置（后备）
# 
# Owner 可以在后台管理界面动态修改 OAuth 配置，无需重启服务器
